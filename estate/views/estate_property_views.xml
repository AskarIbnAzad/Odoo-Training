    <odoo>
        <record id="esate_property_search" model="ir.ui.view">
            <field name="name">estate.property.search</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"></field>
                    <field name="postcode"></field>
                    <field name="expected_price"></field>
                    <field name="selling_price"></field>
                    <field name="date_availability"></field>
                    <filter string="Available" name="available_properties" domain="['|',('state', '=', 'new'), ('state', '=', 'offer_received')]"/>
                    <group>
                        <filter string="postcode" name="group_by_postcode" context="{'group_by' : 'postcode'}"/>
                    </group>
                </search>
            </field>
        </record>
        <record id="estate_property_form" model="ir.ui.view">
            <field name="name">estate.property.form</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <form string="estate property form">
                    <sheet>
                        <group>
                             <group>
                                <field name="name"/>
                                 <field name="postcode"/>
                                 <field name="tag_ids" widget="many2many_tags" />
                            </group>
                             <group>
                                 <field name="state"/>
                                 <field name="active"/>
                                <field name="date_availability"/>

                            </group>
                        </group>
                       <notebook>
                           <page string="Details">
                               <group>
                            <group>
                                <field name="expected_price"/>
                                <field name="bedrooms"/>
                                <field name="facades"/>
                            </group>
                               <group>
                                <field name="selling_price"/>
                                <field name="living_area"/>
                            </group>
                               </group>
                            </page>
                        <page string="Description">
                            <group>
                            <group>
                                <field name="description"/>
                            </group>
                               <group>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area"/>
                                <field name="garden_orientation"/>
                            </group>
                            </group>
                        </page>
                           <page string="Offers">
                            <field name="offer_ids">
                                <list editable="bottom">
                                    <field name="price"/>
                                    <field name="partner_id"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                             <page string="Other Info">
                            <group>
                                <group>
                                    <field name="buyer_id"/>
                                    <field name="salesman_id"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="estate_property_list" model="ir.ui.view">
            <field name="name">estate_property_list</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <list string="estate property list">
                    <field name="name"/>
                    <field name="postcode"/>
                    <field name="expected_price"/>
                    <field name="selling_price"/>
                    <field name="date_availability"/>
                </list>
            </field>
        </record>
        <record id="estate_property_action" model="ir.actions.act_window">
                <field name="name">estate property</field>
                <field name="res_model">estate.property</field>
                <field name="view_mode">list,form</field>
        </record>
    </odoo>
